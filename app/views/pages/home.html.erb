<% content_for :title, "Times Remake — The Living Archive" %>
<section class="hero" aria-label="The living archive">
  <h1 class="sr-only">TIMES REMAKE — THE LIVING ARCHIVE</h1>
  <%= render "shared/interior_image", alt: "Concept interior with concrete columns, wooden tables and rails of archive clothing", loading: "eager", sizes: "100vw", image_class: "hero-image" %>
  <div class="hero-caption"><p>REMAKE / ARCHIVE / BRAND COLLECTION</p><%= link_to "VIEW COLLECTION", shop_path, class: "hero-link" %></div>
</section>

<section class="collection-section page-shell" id="new-arrivals" aria-labelledby="new-arrivals-title">
  <div class="section-heading"><h2 id="new-arrivals-title">NEW ARRIVALS</h2><%= link_to "VIEW ALL", shop_path(sort: "newest"), class: "text-link" %></div>
  <p class="collection-note">Fictional inventory for an educational concept.</p>
  <div class="product-grid"><%= render partial: "shared/product_card", collection: @new_arrivals, as: :product %></div>
  <% if @new_arrivals.empty? %><p class="empty-message">The demonstration archive is being prepared.</p><% end %>
</section>

<section class="editorial" id="stories" aria-label="Times Remake store photographs">
  <figure>
    <div class="editorial-photo"><%= image_tag "times-remake-fumin-road.jpg", srcset: { "times-remake-fumin-road-640.jpg" => "640w", "times-remake-fumin-road.jpg" => "1279w" }, sizes: "(min-width: 768px) 50vw, 100vw", width: 1279, height: 958, class: "interior-image", loading: "lazy", alt: "Times Remake entrance on Fumin Road with its amber illuminated sign" %></div>
    <figcaption class="photo-credit"><span>FUMIN ROAD, SHANGHAI</span><%= link_to "PHOTO: TIMES REMAKE", "https://www.instagram.com/times_remake/p/DbBJ4x6Acdv/", target: "_blank", rel: "noopener noreferrer", aria: { label: "Fumin Road photograph by Times Remake on Instagram (opens in a new tab)" } %></figcaption>
  </figure>
  <figure>
    <div class="story-photo"><%= image_tag "times-remake-changle-road.jpg", srcset: { "times-remake-changle-road-640.jpg" => "640w", "times-remake-changle-road.jpg" => "967w" }, sizes: "(min-width: 768px) 50vw, 100vw", width: 967, height: 775, class: "interior-image", loading: "lazy", alt: "Times Remake on Changle Road with illuminated shop windows and people outside" %></div>
    <figcaption class="photo-credit"><span>CHANGLE ROAD, SHANGHAI</span><%= link_to "PHOTO: TIMES REMAKE", "https://www.instagram.com/times_remake/p/Da5eaBHgSbm/", target: "_blank", rel: "noopener noreferrer", aria: { label: "Changle Road photograph by Times Remake on Instagram (opens in a new tab)" } %></figcaption>
  </figure>
</section>

<section class="collection-section archive-section page-shell" id="archive-selection" aria-labelledby="archive-title">
  <div class="section-heading"><h2 id="archive-title">ARCHIVE SELECTION</h2><%= link_to "VIEW ARCHIVE", shop_path(direction: "archive"), class: "text-link" %></div>
  <div class="product-grid"><%= render partial: "shared/product_card", collection: @archive_products, as: :product %></div>
  <% if @archive_products.empty? %><p class="empty-message">Archive pieces will appear here when the collection is ready.</p><% end %>
</section>

<section class="store-story page-shell" id="concept" aria-labelledby="concept-title">
  <div class="story-copy"><h2 id="concept-title">Times Remake, Shanghai.</h2><p>An independent study of remake, archive clothing and contemporary design, inspired by the store.</p><p class="story-note">Store photographs by Times Remake. The collection is fictional; this project is not affiliated with the store.</p></div>
  <div class="concept-links"><%= link_to "SHOP THE COLLECTION", shop_path, class: "text-link" %><%= link_to "INSTAGRAM", "https://www.instagram.com/times_remake/", target: "_blank", rel: "noopener noreferrer", class: "text-link", aria: { label: "Times Remake on Instagram (opens in a new tab)" } %></div>
</section>
